# Root-level compose env — contains real DB credentials, never commit.
/.env

# macOS
.DS_Store

# Laravel app has its own .gitignore once scaffolded (src/.gitignore), which
# already excludes src/vendor, src/node_modules, src/.env, src/storage/logs, etc.
# Listed again here as a safety net in case that file is ever removed.
/src/.env
/src/vendor/
/src/node_modules/
/src/storage/*.key
/src/storage/framework/cache/*
/src/storage/framework/sessions/*
/src/storage/framework/views/*
/src/storage/logs/*
!/src/storage/framework/cache/.gitignore
!/src/storage/framework/sessions/.gitignore
!/src/storage/framework/views/.gitignore
!/src/storage/logs/.gitignore
