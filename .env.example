# Root-level env file — read ONLY by docker-compose.yml for variable interpolation
# (container build args, MySQL bootstrap credentials). This is NOT the Laravel app's
# own .env — that one lives in src/.env and is created separately by `composer create-project`.
#
# Copy this file to `.env` and fill in real values. Never commit the real `.env`.

APP_ENV=local

# Match your host user so bind-mounted files stay editable without sudo.
# Run `id -u` / `id -g` on macOS/Linux to find your values (1000/1000 covers most cases).
UID=1000
GID=1000

DB_DATABASE=hris_apic
DB_USERNAME=hris_user
DB_PASSWORD=change-me-generate-a-strong-password
DB_ROOT_PASSWORD=change-me-generate-a-different-strong-password

# Only used by docker-compose.prod.yml (mini PC) — the host port nginx listens on,
# reachable only from 127.0.0.1. Point your existing Cloudflare Tunnel's Public
# Hostname route at this port. Irrelevant for local dev, leave unset (default 8081).
# HRIS_PORT=8081
